# Copie para .env.local (desenvolvimento) ou configure no host (Render/Vercel).
# Nunca commite .env com valores reais — só este arquivo com placeholders.

# Supabase → Settings → API
# URL e anon/publishable são usadas no browser (NEXT_PUBLIC_*): podem vazar no bundle,
# mas o acesso aos dados depende das políticas RLS. Não coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable

# Apenas servidor (Server Actions, cron, seed). NUNCA commitar nem usar NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — scripts de deploy / CLI
SUPABASE_PROJECT_REF=seu_project_ref

# URL pública do app (auth redirect, links em e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
