# Copie cada KEY para Render → Web Service → Environment
# VALUES: do seu .env local (nunca commitar secrets)

NODE_VERSION=22

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable
SUPABASE_SERVICE_ROLE_KEY=colar_do_dashboard_supabase

# Troque pelo nome do seu serviço Render (Settings → URL)
NEXT_PUBLIC_SITE_URL=https://seu-servico.onrender.com

# Futuro — cópia de atestados ao RH (docs/FUTURO-EMAIL-ATESTADOS.md)
# RESEND_API_KEY=re_...
# EMAIL_FROM=PontiFy <noreply@fieb.org.br>
# ATESTADO_RH_EMAIL=ngpsenaifeira@fieb.org.br

# Opcional — cron externo (cron-job.org), não obrigatório no Free
# CRON_SECRET=
